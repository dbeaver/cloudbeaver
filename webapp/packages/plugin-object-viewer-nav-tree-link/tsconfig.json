{
  "extends": "@cloudbeaver/tsconfig/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "tsBuildInfoFile": "lib/tsconfig.tsbuildinfo",
    "composite": true
  },
  "references": [
    {
      "path": "../core-cli"
    },
    {
      "path": "../core-connections"
    },
    {
      "path": "../core-data-context"
    },
    {
      "path": "../core-di"
    },
    {
      "path": "../core-localization"
    },
    {
      "path": "../core-navigation-tree"
    },
    {
      "path": "../core-view"
    },
    {
      "path": "../plugin-datasource-context-switch"
    },
    {
      "path": "../plugin-navigation-tree"
    }
  ],
  "include": [
    "__custom_mocks__/**/*",
    "src/**/*",
    "src/**/*.json",
    "src/**/*.css"
  ],
  "exclude": [
    "**/node_modules",
    "lib/**/*"
  ]
}
