{
  "extends": "@cloudbeaver/tsconfig/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "tsBuildInfoFile": "lib/tsconfig.tsbuildinfo",
    "composite": true
  },
  "references": [
    {
      "path": "../core-cli"
    },
    {
      "path": "../core-connections"
    },
    {
      "path": "../core-di"
    },
    {
      "path": "../core-resource"
    },
    {
      "path": "../core-sdk"
    },
    {
      "path": "../core-utils"
    }
  ],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "lib/**/*"
  ]
}
