<?xml version='1.0' encoding='UTF-8'?>
<schema targetNamespace="io.cloudbeaver.model" xmlns="http://www.w3.org/2001/XMLSchema">
   <annotation><appInfo><meta.schema plugin="io.cloudbeaver.model" id="org.jkiss.dbeaver.auth.provider" name="Authentication provider"/></appInfo><documentation>CloudBeaver authentication providers</documentation></annotation>

   <element name="extension">
      <complexType>
         <choice minOccurs="0" maxOccurs="unbounded">
            <element ref="authProvider"/>
            <element ref="authProviderDisable"/>
            <element ref="commonProviderProperties"/>
         </choice>
         <attribute name="point" type="string" use="required"/>
         <attribute name="id" type="string"/>
         <attribute name="name" type="string"/>
      </complexType>
   </element>

   <element name="authProvider">
      <complexType>
         <choice minOccurs="0" maxOccurs="unbounded">
            <element ref="configuration"/>
            <element ref="credentials"/>
            <element ref="metaParameters"/>
         </choice>
         <attribute name="id" type="string" use="required"><annotation><appInfo><meta.attribute kind="identifier"/></appInfo></annotation></attribute>
         <attribute name="extended" type="string"/>
         <attribute name="label" type="string"><annotation><appInfo><meta.attribute translatable="true"/></appInfo></annotation></attribute>
         <attribute name="description" type="string"><annotation><appInfo><meta.attribute translatable="true"/></appInfo></annotation></attribute>
         <attribute name="class" type="string" use="required"><annotation><appInfo><meta.attribute kind="java" basedOn=":org.jkiss.dbeaver.model.auth.SMAuthProvider"/></appInfo></annotation></attribute>
         <attribute name="icon" type="string"><annotation><appInfo><meta.attribute kind="resource"/></appInfo></annotation></attribute>
         <attribute name="configurable" type="boolean"/>
         <attribute name="trusted" type="boolean"/>
         <attribute name="private" type="boolean"/>
         <attribute name="required" type="boolean"/>
         <attribute name="authHidden" type="boolean"/>
         <attribute name="caseInsensitive" type="boolean"/>
         <attribute name="sameTabRedirectOnLogout" type="boolean"/>
         <attribute name="serviceProvider" type="boolean"/>
         <attribute name="requiredFeatures" type="string"/>
         <attribute name="categories" type="string"/>
      </complexType>
   </element>

   <element name="authProviderDisable">
      <complexType><attribute name="id" type="string" use="required"/></complexType>
   </element>

   <element name="commonProviderProperties">
      <complexType>
         <sequence><element ref="propertyGroup" minOccurs="0" maxOccurs="unbounded"/></sequence>
         <attribute name="supportedProviderCategories" type="string"/>
         <attribute name="exclude" type="string"/>
      </complexType>
   </element>

   <element name="configuration">
      <complexType><sequence><element ref="propertyGroup" minOccurs="0" maxOccurs="unbounded"/></sequence></complexType>
   </element>

   <element name="credentials">
      <complexType>
         <sequence><element ref="propertyGroup" minOccurs="0" maxOccurs="unbounded"/></sequence>
         <attribute name="id" type="string"/>
         <attribute name="label" type="string"><annotation><appInfo><meta.attribute translatable="true"/></appInfo></annotation></attribute>
         <attribute name="description" type="string"><annotation><appInfo><meta.attribute translatable="true"/></appInfo></annotation></attribute>
      </complexType>
   </element>

   <element name="metaParameters">
      <complexType>
         <sequence><element ref="propertyGroup" minOccurs="0" maxOccurs="unbounded"/></sequence>
          <attribute name="type" use="required">
             <simpleType>
                <restriction base="string">
                   <enumeration value="user"/>
                   <enumeration value="team"/>
                </restriction>
             </simpleType>
          </attribute>
      </complexType>
   </element>

   <element name="propertyGroup">
      <complexType>
         <sequence><element ref="property" minOccurs="0" maxOccurs="unbounded"/></sequence>
         <attribute name="label" type="string"><annotation><appInfo><meta.attribute translatable="true"/></appInfo></annotation></attribute>
      </complexType>
   </element>

   <element name="property">
      <complexType>
         <attribute name="id" type="string" use="required"/>
         <attribute name="label" type="string"><annotation><appInfo><meta.attribute translatable="true"/></appInfo></annotation></attribute>
         <attribute name="description" type="string"><annotation><appInfo><meta.attribute translatable="true"/></appInfo></annotation></attribute>
         <attribute name="hint" type="string"><annotation><appInfo><meta.attribute translatable="true"/></appInfo></annotation></attribute>
          <attribute name="type">
             <simpleType>
                <restriction base="string">
                   <enumeration value="string"/>
                   <enumeration value="boolean"/>
                   <enumeration value="short"/>
                   <enumeration value="integer"/>
                   <enumeration value="long"/>
                   <enumeration value="float"/>
                   <enumeration value="double"/>
                   <enumeration value="numeric"/>
                   <enumeration value="file"/>
                </restriction>
             </simpleType>
          </attribute>
         <attribute name="required" type="boolean"/>
         <attribute name="defaultValue" type="string"/>
         <attribute name="validValues" type="string"/>
         <attribute name="allowCustomValues" type="boolean"/>
         <attribute name="features" type="string"/>
          <attribute name="length">
             <simpleType>
                <restriction base="string">
                   <enumeration value="TINY"/>
                   <enumeration value="SHORT"/>
                   <enumeration value="MEDIUM"/>
                   <enumeration value="LONG"/>
                   <enumeration value="MULTILINE"/>
                </restriction>
             </simpleType>
          </attribute>
         <attribute name="desktop" type="boolean"/>
         <attribute name="hidden" type="boolean"/>
         <attribute name="hideExpr" type="string"/>
         <attribute name="readOnlyExpr" type="string"/>
         <attribute name="requiredFeatures" type="string"/>
          <attribute name="encryption">
             <simpleType>
                <restriction base="string">
                   <enumeration value="none"/>
                   <enumeration value="plain"/>
                   <enumeration value="hash"/>
                </restriction>
             </simpleType>
          </attribute>
         <attribute name="identifying" type="boolean"/>
         <attribute name="admin" type="boolean"/>
         <attribute name="user" type="boolean"/>
      </complexType>
   </element>
</schema>
