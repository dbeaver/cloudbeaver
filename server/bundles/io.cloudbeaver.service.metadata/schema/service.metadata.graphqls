# Metadata queries

extend type Query {

    # Get child nodes
    "Returns node DDL for the specified node ID"
    metadataGetNodeDDL(nodeId: ID!, options: Object): String
    "Returns extended node DDL for the specified node ID (e.g., Oracle or MySQL package)"
    metadataGetNodeExtendedDDL(nodeId: ID!): String

}

extend type Mutation {

    "Creates async task to generate DDL for the specified node ID. Generated DDL is returned in the taskResult field"
    asyncMetadataGetNodeDDL(nodeId: ID!, options: Object): AsyncTaskInfo! @since(version: "26.1.4")

}
