<?xml version='1.0' encoding='UTF-8'?>
<schema targetNamespace="io.cloudbeaver.server" xmlns="http://www.w3.org/2001/XMLSchema">
   <annotation>
      <appInfo>
         <meta.schema plugin="io.cloudbeaver.server" id="io.cloudbeaver.connectionTestConfigurator" name="Connection test configurators"/>
      </appInfo>
      <documentation>
         Configures driver-specific settings on a temporary datasource before a generic connection test.
      </documentation>
   </annotation>

   <element name="extension">
      <annotation>
         <appInfo>
            <meta.element />
         </appInfo>
      </annotation>
      <complexType>
         <sequence>
            <element ref="configurator" minOccurs="1" maxOccurs="unbounded"/>
         </sequence>
      </complexType>
   </element>

   <element name="configurator">
      <complexType>
         <attribute name="id" type="string" use="required"/>
         <attribute name="class" type="string" use="required">
            <annotation>
               <appInfo>
                  <meta.attribute kind="java" basedOn="io.cloudbeaver.registry.DBWConnectionTestConfigurator:"/>
               </appInfo>
            </annotation>
         </attribute>
      </complexType>
   </element>
</schema>
